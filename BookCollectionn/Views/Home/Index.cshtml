<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Collection</title>
    <style>
        body {
            background-color: #f9f9f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
        }

        main {
            padding: 2rem;
            max-width: 1200px;
            margin: auto;
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 2rem;
            color: #333;
            text-align: center;
            font-weight: 700;
        }

        .row {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 1rem;
        }

        .col-md-4 {
            flex: 1 1 calc(30% - 1rem);
            background-color: #e0e0e0;
            border-radius: 8px;
            padding: 1.5rem;
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.1);
            text-align: center;
            margin-bottom: 2rem;
            transition: transform 0.2s;
        }

            .col-md-4:hover {
                transform: scale(1.02);
            }

            .col-md-4 h2 {
                font-size: 1.5rem;
                font-weight: 600;
                color: #444;
                margin-bottom: 1rem;
            }

        .form-control {
            margin: 0.5rem 0;
            width: 100%;
            padding: 0.5rem;
            border-radius: 4px;
            border: 1px solid #ccc;
        }

        .btn {
            margin-top: 1rem;
            background-color: #007bff;
            color: #fff;
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

            .btn:hover {
                background-color: #0056b3;
                transform: translateY(-2px);
            }

        footer {
            text-align: center;
            margin-top: 3rem;
            padding: 1rem 0;
            background-color: #f1f1f1;
            color: #666;
            border-top: 1px solid #e0e0e0;
        }
    </style>
</head>
<body>
    <main>
        <h1>Book Collection</h1>
        <div class="row">
            <!-- Book List Section -->
            <section class="col-md-4">
                <h2>Book List</h2>
                <div id="book-list">
                    <!-- Dynamic content will be populated here -->
                </div>
                <button class="btn" onclick="addBook()">ADD</button>
            </section>

            <!-- Book Detail Section -->
            <section class="col-md-4">
                <h2>Book Detail</h2>
                <div id="book-detail">
                    <p>Select a book to view details.</p>
                </div>
            </section>

            <!-- Update Book Form -->
            <section class="col-md-4">
                <h2>Update Book Form</h2>
                <input type="text" id="book-title" class="form-control" placeholder="Title" aria-label="Book Title" />
                <input type="text" id="book-author" class="form-control" placeholder="Author" aria-label="Author Name" />
                <input type="text" id="book-year" class="form-control" placeholder="Publication Year" aria-label="Publication Year" />
                <button class="btn" onclick="updateBook()">Update</button>
            </section>
        </div>

        <footer>
            <p>&copy; 2024 Your Book Collection</p>
        </footer>
    </main>

    <script>
        const books = []; 
        let currentBookIndex = null; 

        // Function to add a book
        function addBook() {
            const title = document.getElementById('book-title').value;
            const author = document.getElementById('book-author').value;
            const year = document.getElementById('book-year').value;

            if (title && author && year) {
                const book = { title, author, year };
                books.push(book);
                displayBooks();
                clearForm();
            } else {
                alert('Please fill in all fields.');
            }
        }

        // Function to display books
        function displayBooks() {
            const bookList = document.getElementById('book-list');
            bookList.innerHTML = ''; 

            books.forEach((book, index) => {
                const bookItem = document.createElement('div');
                bookItem.textContent = `${book.title} by ${book.author} (${book.year})`;
                bookItem.onclick = () => showDetails(index); 
                bookItem.style.cursor = 'pointer';
                bookItem.style.padding = '0.5rem';
                bookItem.style.borderBottom = '1px solid #ccc';
                bookList.appendChild(bookItem);
            });
        }

        // Function to show book details
        function showDetails(index) {
            const book = books[index];
            const bookDetail = document.getElementById('book-detail');
            bookDetail.innerHTML = `<strong>Title:</strong> ${book.title}<br><strong>Author:</strong> ${book.author}<br><strong>Year:</strong> ${book.year}`;
            currentBookIndex = index; 
        }

        // Function to clear form fields
        function clearForm() {
            document.getElementById('book-title').value = '';
            document.getElementById('book-author').value = '';
            document.getElementById('book-year').value = '';
        }

        // Function to update a book
        function updateBook() {
            if (currentBookIndex !== null) {
                const title = document.getElementById('book-title').value;
                const author = document.getElementById('book-author').value;
                const year = document.getElementById('book-year').value;

                if (title && author && year) {
                    books[currentBookIndex] = { title, author, year }; 
                    displayBooks(); 
                    clearForm();
                    currentBookIndex = null; 
                    document.getElementById('book-detail').innerHTML = 'Select a book to view details.'; 
                } else {
                    alert('Please fill in all fields.');
                }
            } else {
                alert('Please select a book to update.');
            }
        }
    </script>
</body>
</html>
