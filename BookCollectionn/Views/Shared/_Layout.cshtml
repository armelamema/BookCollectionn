<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "Default Title" + " - Book Collection")</title>

    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/5.1.3/css/bootstrap.min.css" integrity="sha384-KyZXEAg3QhqLMpG8r+Knujsl5+5hb7x1XK/6Y5/VqqH+0I5pO1R0x0h2D2Y2pU9" crossorigin="anonymous">
    @Scripts.Render("~/bundles/modernizr")
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4; 
            margin: 0;
        }

        .taskbar {
            background-color: #343a40;
            display: flex; 
            align-items: center; 
            padding: 10px 20px; 
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
            position: fixed; 
            width: 100%;
            z-index: 1000; 
        }

            .taskbar .brand {
                font-weight: bold;
                font-size: 1.5rem;
                color: white; 
                margin-right: 20px; 
            }

            .taskbar .nav-item {
                margin: 0 15px;
            }

            .taskbar .nav-link {
                color: white; 
                font-weight: 500; 
                transition: background-color 0.3s, color 0.3s; 
                text-decoration: none; 
                padding: 10px 15px; 
                border-radius: 5px; 
            }

                .taskbar .nav-link:hover {
                    background-color: #007bff;
                    color: white; 
                }

        .container.body-content {
            padding-top: 80px; 
            padding: 50px 15px; 
        }

        footer {
            background-color: #f8f9fa; 
            padding: 20px 0;
            text-align: center;
            margin-top: 30px; 
        }

            footer p {
                margin: 0; 
                color: #6c757d; 
            }
    </style>
</head>
<body>
    <nav class="taskbar">
        <span class="brand">Book Collection</span>
        <div class="nav-item">
            <a class="nav-link" href="#">Home</a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="#">About</a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="#">Genres</a>
        </div>
        <div class="nav-item">
            <a class="nav-link" href="#">Authors</a>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Book Collection</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ChfqqxuZUCnJSK3MX2G5uY8zA4k1iQ3BzRZ9R4pEFUQzV1N3eI5pO1R0x0h2D2Y2" crossorigin="anonymous"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
