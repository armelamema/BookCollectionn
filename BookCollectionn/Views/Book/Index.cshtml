@model IEnumerable<BookCollectionn.Models.Book>

@{
    ViewData["Title"] = "Home Page";
}

<h2>Welcome to the Book Collection!</h2>
<p>This is the home page for your book collection management application.</p>

<h2>Books List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Book</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Book Title</th>
            <th>Author</th>
            <th>Genre</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center">No books available.</td>
            </tr>
        }
        else
        {
            foreach (var book in Model)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author?.Name</td>
                    <td>
                        @if (book.BookGenres.Any())
                        {
                            foreach (var genre in book.BookGenres)
                            {
                                @genre.Genre.Name<br />
                            }
                        }
                        else
                        {
                            <span class="text-muted">No genres assigned</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@book.BookID" class="btn btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@book.BookID" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this book?');">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
